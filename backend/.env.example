# Rename to .env and fill in the values for local development.
# DO NOT commit real values.

# PostgreSQL — provided by the Clever Cloud addon in production.
POSTGRESQL_ADDON_URI=postgresql://user:password@host:5432/dbname

# 32-byte base64 encryption key used to encrypt OAuth tokens at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Random secret used by tower-sessions.
SESSION_SECRET=change-me

# Clever Cloud OAuth 1.0a consumer credentials (create an app in the CC console).
CC_OAUTH_CONSUMER_KEY=
CC_OAUTH_CONSUMER_SECRET=

CC_API_BASE_URL=https://api.clever-cloud.com
WARP10_ENDPOINT=https://c2-warp10-clevercloud-customers.services.clever-cloud.com/api/v0/exec

# URL where the frontend is reachable by the browser.
FRONTEND_URL=http://localhost:3000
# URL where this backend is reachable — used to build the OAuth callback.
APP_URL=http://localhost:8080

# Serve the built frontend from here (single-origin deploy). Leave empty in dev.
# STATIC_DIR=../frontend/dist

PORT=8080
WS_POLL_STATUS_SECS=10
WS_POLL_METRICS_SECS=15

RUST_LOG=info,sqlx=warn,tower_http=info

# Error monitoring + tracing → GlitchTip (Sentry-compatible).
# Leave SENTRY_DSN empty to disable (no-op, no events sent).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Trace every outgoing request to the CC API + Warp10 (method, URL, status,
# duration). One INFO line per request. Use to catalogue endpoints / return
# codes when investigating OAuth scope quirks. Accepts: 1|true|TRUE|yes.
DEBUG_CC_API=false
