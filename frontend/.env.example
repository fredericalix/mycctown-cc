# Rename to .env (or .env.local) and fill in for local development.
# Vite reads VITE_* at build time and inlines them into the bundle.
# DO NOT commit real values.

# Error monitoring + tracing → GlitchTip (Sentry-compatible).
# Leave VITE_SENTRY_DSN empty to disable (init becomes no-op, no events sent).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Optional: tag events with a release name (e.g. git short SHA).
VITE_SENTRY_RELEASE=

# GlitchTip Personal Auth Token — only needed at build time to upload sourcemaps.
# Leave empty to skip (the @sentry/vite-plugin is a no-op without it).
# Generate from GlitchTip → Profile → Auth Tokens.
SENTRY_AUTH_TOKEN=
# Your GlitchTip/Sentry server and organisation slug (upload skipped if unset).
# SENTRY_URL=https://glitchtip.example.com
# SENTRY_ORG=my-org
# SENTRY_PROJECT=mycctown-frontend

# Optional: force the debug logger on without DEV.
# VITE_DEBUG_LOGS=true

# Optional: override the public Cellar URL for ambient music in dev.
# Leave empty to use the local /music folder fallback.
# VITE_MUSIC_BASE_URL=
