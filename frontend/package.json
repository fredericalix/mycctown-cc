{
  "name": "mycctown-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run sync-music && node scripts/check-assets.mjs",
    "prebuild": "node scripts/check-assets.mjs",
    "build": "tsc && npm run sync-docs-img && npm run sync-music && vite build",
    "compress-gltf": "node scripts/compress-gltf.mjs",
    "sync-docs-img": "mkdir -p public/docs/img && cp -f ../docs/img/*.png public/docs/img/ 2>/dev/null || true",
    "sync-music": "mkdir -p public/music && cp -f ../music/*.mp3 public/music/ 2>/dev/null || true",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "node server.mjs",
    "assets:install": "node scripts/install-assets.mjs",
    "assets:check": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@sentry/react": "^10.50.0",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "http-proxy-middleware": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.172.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.2.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "daisyui": "^5.5.19",
    "gltfpack": "^1.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
