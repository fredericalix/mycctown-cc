# Template — copy to `scripts/.env.dev` (gitignored) and fill in the values.
#
# Usage:
#   cp scripts/.env.dev.example scripts/.env.dev
#   # edit scripts/.env.dev
#   ./scripts/setup-dev-env.sh
#
# Note: the OAuth consumer "myCCtown-dev" is created automatically by the
# script via `clever oauth-consumers create`, and its key+secret are read
# back via `oauth-consumers get --with-secret`. No manual console step
# required.

# ─── GlitchTip DSNs ──────────────────────────────────────────────
# Same projects as prod are fine — events are filtered by
# SENTRY_ENVIRONMENT=development on the GlitchTip side.
# Backend DSN  → your GlitchTip/Sentry project for the backend
# Frontend DSN → your GlitchTip/Sentry project for the frontend
SENTRY_DSN_BACKEND_DEV=
VITE_SENTRY_DSN_DEV=

# Personal auth token used by @sentry/vite-plugin to upload sourcemaps.
# Same value as on the prod frontend app is fine.
SENTRY_AUTH_TOKEN_DEV=

# ─── Optional ────────────────────────────────────────────────────
# 32-byte base64 key used by the backend to encrypt OAuth tokens at rest.
# Leave empty: the script auto-generates one with `openssl rand -base64 32`
# and appends it to this file so subsequent runs reuse the same key.
ENCRYPTION_KEY_DEV=

# Public base URL of the Cellar/S3 bucket holding the ambient MP3s
# (e.g. https://<bucket>.cellar-c2.services.clever-cloud.com). Empty = no music.
MUSIC_BASE_URL=
